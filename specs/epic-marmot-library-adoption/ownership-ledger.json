{
  "epic": "marmot-library-adoption",
  "concepts": [
    {
      "id": "client",
      "name": "One MarmotClient per account, built only in browser effects, lease-bound writes",
      "owning_module": "client",
      "type": "invariant",
      "added_by_story": null
    },
    {
      "id": "history",
      "name": "Durable at-least-once, seq-ordered sink idempotent by kind-445 event id",
      "owning_module": "history",
      "type": "invariant",
      "added_by_story": null
    },
    {
      "id": "handlers",
      "name": "Group handlers take sender only from orderingKey.account",
      "owning_module": "handlers",
      "type": "invariant",
      "added_by_story": null
    },
    {
      "id": "send",
      "name": "sendGroupRumor canonical rumor id equals sink echo id",
      "owning_module": "send",
      "type": "public_contract",
      "added_by_story": null
    },
    {
      "id": "invitations",
      "name": "Pending store is invitations.pending(); deny layer, caps, single-candidate invite",
      "owning_module": "invitations",
      "type": "validation_rule",
      "added_by_story": null
    },
    {
      "id": "join-requests",
      "name": "Join-request protocol on the library inbox, auto-accept at most once",
      "owning_module": "joinRequests",
      "type": "public_contract",
      "added_by_story": null
    },
    {
      "id": "membership",
      "name": "Leave eligibility, admin ops, local purge (abandon)",
      "owning_module": "membership",
      "type": "validation_rule",
      "added_by_story": null
    },
    {
      "id": "kinds",
      "name": "App/inbox/retired kind registry with import-time collision check",
      "owning_module": "kinds",
      "type": "naming_scheme",
      "added_by_story": null
    },
    {
      "id": "media",
      "name": "Encrypted media via group.encryptMedia/decryptMedia, Blossom upload",
      "owning_module": "media",
      "type": "path_convention",
      "added_by_story": null
    },
    {
      "id": "backup",
      "name": "Backup payload has settings and own profile only; NIP-44 to own key",
      "owning_module": "backup",
      "type": "invariant",
      "added_by_story": null
    },
    {
      "id": "marmot-context",
      "name": "Thin composition root exposing useMarmot() with no protocol logic",
      "owning_module": "MarmotContext",
      "type": "public_contract",
      "added_by_story": null
    },
    {
      "id": "client.AccountClientHandle",
      "name": "{client,pubkey,leaseHeld,enqueue}; leaseHeld reads stores.lease.held",
      "owning_module": "client",
      "type": "public_contract",
      "added_by_story": "S1"
    },
    {
      "id": "client.ClientJobQueue",
      "name": "One setTimeout(0) FIFO for ready jobs. Group history and inbox callbacks hold their own follow-ups until settlement.",
      "owning_module": "client",
      "type": "invariant",
      "added_by_story": "S1"
    },
    {
      "id": "client.InboxRelayListEnsure",
      "name": "kind-10050 ensure port, called once after key-package ensure, non-fatal",
      "owning_module": "client",
      "type": "public_contract",
      "added_by_story": "S1"
    },
    {
      "id": "client.bootstrap-order",
      "name": "gates > openForWrite > createMarmotClient > listeners > inbox handlers 21059/21064 > groups.list > onNotification > inbox.start > KP ensure > 10050 ensure; abortable; fatal step runs contract-order teardown",
      "owning_module": "client",
      "type": "invariant",
      "added_by_story": "S1"
    },
    {
      "id": "client.teardown-order",
      "name": "queue.dispose > unsubscribe > client.dispose > stores.close > pool.destroy; idempotent",
      "owning_module": "client",
      "type": "invariant",
      "added_by_story": "S1"
    },
    {
      "id": "client.inbox-kinds-local",
      "name": "INBOX_HANDLER_KINDS defined locally in client; S2 must replace with AppKinds",
      "owning_module": "client",
      "type": "naming_scheme",
      "added_by_story": "S1"
    },
    {
      "id": "testhooks.groupLibrary-smoke",
      "name": "Dev-only __fewTest.groupLibrary hook installed from MarmotContext.tsx; S18 must keep it; S27 removes it",
      "owning_module": "testHooks",
      "type": "path_convention",
      "added_by_story": "S1"
    },
    {
      "id": "library.own-confirmed-withdraw",
      "name": "Own message confirmed on a branch that later loses IS withdrawn through the sink → failed/retry (AC-WDR-2); detection triggers never downgrade confirmed rows",
      "owning_module": "history",
      "type": "invariant",
      "added_by_story": "S1"
    },
    {
      "id": "client.group-attach",
      "name": "Notification listeners attach per handle (WeakSet), automatically on groupCreated/groupJoined via FIFO; attachGroup idempotent fallback, no-op after teardown",
      "owning_module": "client",
      "type": "invariant",
      "added_by_story": "S1"
    },
    {
      "id": "nip46-perms",
      "name": "Requested NIP-46 perms = library toNip46Perms() ∪ sign_event:{0,20602,30078,10050}; stored session discarded unless recordedPerms (requested set saved at connect) covers it; null discards",
      "owning_module": "nip46Perms",
      "type": "validation_rule",
      "added_by_story": "S2"
    },
    {
      "id": "history.GroupHistoryHandlers",
      "name": "{dispatch, retract}({groupId,eventId,rumor,sender}); sender=orderingKey.account; dispatch idempotent, throws on durable failure; retract of unseen id no-op; only APP_RUMOR_KINDS reach handlers",
      "owning_module": "history",
      "type": "public_contract",
      "added_by_story": "S3"
    },
    {
      "id": "history.no-tombstone",
      "name": "withdraw of unknown id is a no-op; later append of a withdrawn id is applied (re-canonicalised branch)",
      "owning_module": "history",
      "type": "invariant",
      "added_by_story": "S3"
    },
    {
      "id": "history.seq-single-writer",
      "name": "seq get-then-set safe only with one backend instance per account under the lease",
      "owning_module": "history",
      "type": "invariant",
      "added_by_story": "S3"
    },
    {
      "id": "history.first-touch-recovery",
      "name": "Before a group first append/withdraw per instance, its dispatched:false rows are re-dispatched in seq order in the same serialised job; abandoned after 5 persisted failures",
      "owning_module": "history",
      "type": "invariant",
      "added_by_story": "S3"
    },
    {
      "id": "handlers.groupOf",
      "name": "Injected groupOf(groupId) via client.groups.get for live roster/admin gates; safe inside append (drain starts after runtime cached, group-runtime.js:1196-1217)",
      "owning_module": "handlers",
      "type": "public_contract",
      "added_by_story": "S3 (decider)"
    },
    {
      "id": "history.lifecycle",
      "name": "Sink single-use per bootstrap, per-account DB few-group-history:<pubkey>; dispose() drains serialiser (≤10 s) and is awaited in teardown before client.dispose; writes are no-ops after dispose",
      "owning_module": "history",
      "type": "invariant",
      "added_by_story": "S3"
    },
    {
      "id": "history.late-retract",
      "name": "withdraw/purge of an id whose dispatch outlives 10 s retracts once on completion via the per-group serialiser, skipped if the row exists again, ≤3 bounded retries",
      "owning_module": "history",
      "type": "invariant",
      "added_by_story": "S3"
    },
    {
      "id": "handlers.own-echo",
      "name": "Sink delivery from self confirms optimistic row by rumor.id (onOwnEcho), never unread/bell; own withdraw → onOwnWithdrawn (failed/retry), never deleted",
      "owning_module": "handlers",
      "type": "invariant",
      "added_by_story": "S4"
    },
    {
      "id": "handlers.notification-router",
      "name": "onGroupNotification drives members/admins/name/disband only, never message stores",
      "owning_module": "handlers",
      "type": "public_contract",
      "added_by_story": "S4"
    },
    {
      "id": "knownPeers.sender-add",
      "name": "Peer senders added to known peers on sink dispatch (subset of roster seeding); never undone by retract",
      "owning_module": "handlers",
      "type": "invariant",
      "added_by_story": "S4"
    },
    {
      "id": "handlers.gates",
      "name": "Roster/admin gates read live group.members()/group.admins via injected groupOf; undefined fails closed (row dispatched), rejection propagates (row retried)",
      "owning_module": "handlers",
      "type": "validation_rule",
      "added_by_story": "S5"
    },
    {
      "id": "reactions.held",
      "name": "Reactions to unknown targets held (TTL 7 d, cap 200/thread, dedup by rumor id), released after each kind-9 insert",
      "owning_module": "reactions",
      "type": "invariant",
      "added_by_story": "S5"
    },
    {
      "id": "unread.recompute",
      "name": "recomputeUnread shares predicate with initUnreadCounts",
      "owning_module": "unreadStore",
      "type": "invariant",
      "added_by_story": "S5"
    },
    {
      "id": "history.withdraw-protocol",
      "name": "Mark all batch rows withdrawing (durable), then per row in seq order retract (remaining() memoised, RetractInput.batch) then delete, each bounded; leftovers finished by next touch/withdraw/sweep/restart before re-dispatch",
      "owning_module": "history",
      "type": "invariant",
      "added_by_story": "S5"
    },
    {
      "id": "history.RetractInput",
      "name": "retract({groupId,eventId,rumor,sender,receivedAt,reason?,remaining,batch?}); remaining()=dispatched non-withdrawing rows in seq order",
      "owning_module": "history",
      "type": "public_contract",
      "added_by_story": "S5"
    },
    {
      "id": "handlers.recompute-on-retract",
      "name": "Dependent kinds 5/edit-9/7/10-12 recompute aggregate = base + fold(remaining()) via dispatch core; effect-free; clock = persisted receivedAt (live dispatch too); contribution=(rumor id, sender); depends on pre-adoption purge before first sink delivery",
      "owning_module": "handlers",
      "type": "invariant",
      "added_by_story": "S5"
    },
    {
      "id": "chat.original-snapshot",
      "name": "write-once original on GROUP chat rows = slot base, captured by first signal write incl. own optimistic, never DMs; cleared when slot recomputes to no signals",
      "owning_module": "chatPersistence",
      "type": "invariant",
      "added_by_story": "S5"
    },
    {
      "id": "profile.one-shot-gate",
      "name": "profile apply one-shot per (group, inner event id), LRU 1024; accepted marker consumed last, announcement enqueued very last",
      "owning_module": "handlers",
      "type": "invariant",
      "added_by_story": "S5"
    },
    {
      "id": "send.own-row-lifecycle",
      "name": "sending -> confirmed (echo, also from failed) | failed (own intent failed, groupBranchSwitched, send reject unless still queued, 60 s after the group is synced); confirmed downgraded only by an explicit own withdraw of its last carrier; retry re-sends the identical rumor; no auto-resend",
      "owning_module": "send",
      "type": "invariant",
      "added_by_story": "S6"
    },
    {
      "id": "send.group-op-queue",
      "name": "Commit ops serialised per group; bounded synced() wait with abort; commit-pending retried only for library-cleared reasons with a real barrier + backoff; errors isolated per op",
      "owning_module": "send",
      "type": "invariant",
      "added_by_story": "S6"
    },
    {
      "id": "invitations.caps",
      "name": "Trust-ordered caps: deny → stranger TTL 14 d → per-inviter 8 → total 256 trusted-first then oldest; shown ids keep their place; all declines silent",
      "owning_module": "invitations",
      "type": "validation_rule",
      "added_by_story": "S9"
    },
    {
      "id": "invitations.decline-rumor",
      "name": "Library sends the decline rumor ONLY when declineRumor===true; user decline gated on visibility (never rumors a blocked/hidden sponsor)",
      "owning_module": "invitations",
      "type": "invariant",
      "added_by_story": "S9"
    },
    {
      "id": "invitations.invite-context",
      "name": "Sponsor sends one gift-wrapped 21064 {groupId,name} to the invitee after delivered/retryable invite; invitee drops blocked senders, dedupes, holds unmatched contexts (8/sender, 64 total, 7 d), validates against sponsorAccount/sponsors, shows only a matched sanitised name (else generic label)",
      "owning_module": "invitations",
      "type": "invariant",
      "added_by_story": "S10"
    },
    {
      "id": "membership.adminOps",
      "name": "Serialized admin operations, including ref-bound invitation cancellation",
      "owning_module": "membership",
      "type": "public_contract",
      "added_by_story": "S14"
    }
  ],
